<idea-plugin>
    <id>com.pentryyy.pretty-log-json</id>
    <name>Pretty Log JSON</name>
    <vendor/>
    <description><![CDATA[
        Форматирует JSON-логи: удаляет строки /entrypoint.sh: и красиво выводит объекты JSON.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>

    <actions>
        <action id="FormatLogAction"
                class="com.pentryyy.prettylogjson.actions.FormatLogAction"
                icon="/icons/formatIcon.svg"
                text="Pretty Log JSON"
                description="Форматирует логи в JSON"
        >
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift p"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <applicationInitializedListener implementation="com.pentryyy.prettylogjson.utils.PluginInitializer"/>
    </extensions>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>
</idea-plugin>